# =================================================================
# JoyfulGenius Backend — Environment Variable Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.
# =================================================================

NODE_ENV=development
PORT=4001
FRONTEND_URL=http://localhost:5173

# ── MongoDB ───────────────────────────────────────────────────────
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/NMMS_dev

# ── JWT ───────────────────────────────────────────────────────────
# Use long, random strings. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_use_a_random_64_char_string
JWT_REFRESH_SECRET=CHANGE_ME_use_a_different_random_64_char_string

# ── Email ─────────────────────────────────────────────────────────
# Provider: smtp (Gmail), resend, or sendgrid
EMAIL_PROVIDER=smtp

# Gmail SMTP (dev only — use Resend or SendGrid in production)
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password

# Resend (recommended for production)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SendGrid
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Razorpay ──────────────────────────────────────────────────────
# Use rzp_test_* keys for development, rzp_live_* for production
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_from_dashboard

# ── AWS S3 ────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AWS_S3_BUCKET=your-bucket-name
# Optional: CloudFront CDN base URL
# AWS_S3_PUBLIC_BASE=https://cdn.yourdomain.com

# ── Sentry (optional but recommended for production) ──────────────
# Get DSN from https://sentry.io → Project → Settings → Client Keys
SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx

# ── Diagnostics ───────────────────────────────────────────────────
# Long random string required to hit /health/full in production. Leave blank locally.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HEALTH_TOKEN=

# ── API Documentation ─────────────────────────────────────────────
# Swagger UI is always on in development. Set to "true" in production to
# expose /api/docs to logged-in partners. Otherwise the docs return 404.
SWAGGER_ENABLED=false
